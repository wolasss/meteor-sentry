{
    "name": "meteor-sentry",
    "version": "4.0.0",
    "description": "A simple wrapper for sentry SDK. Allows to use sentry in both client and server in meteor apps.",
    "main": "package.js",
    "directories": {
        "lib": "lib"
    },
    "scripts": {
        "test": "TEST_BROWSER_DRIVER=playwright meteor test-packages ./ --driver-package meteortesting:mocha --once --port 3457",
        "audit:runtime": "node scripts/audit-runtime-deps.mjs",
        "test:audit": "node --test 'scripts/**/*.test.mjs'",
        "release": "semantic-release",
        "prepare": "husky",
        "build:client-sdk": "node scripts/build-client-sdk.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:wolasss/meteor-sentry.git"
    },
    "author": "Adam Wolski",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/wolasss/meteor-sentry/issues"
    },
    "homepage": "https://github.com/wolasss/meteor-sentry#readme",
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/npm": "^13.2.0",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@sentry/browser": "11.10.0",
        "esbuild": "0.28.2",
        "husky": "^9.1.7",
        "playwright": "1.64.1",
        "semantic-release": "^25.0.9"
    },
    "release": {
        "branches": [
            "master"
        ],
        "ci": false,
        "plugins": [
            [
                "@semantic-release/commit-analyzer",
                {
                    "preset": "angular",
                    "releaseRules": [
                        {
                            "type": "docs",
                            "release": "patch"
                        },
                        {
                            "type": "chore",
                            "release": "patch"
                        },
                        {
                            "type": "refactor",
                            "release": "patch"
                        }
                    ]
                }
            ],
            "@semantic-release/release-notes-generator",
            "@semantic-release/changelog",
            [
                "@semantic-release/npm",
                {
                    "npmPublish": false
                }
            ],
            "@semantic-release/git"
        ]
    }
}
